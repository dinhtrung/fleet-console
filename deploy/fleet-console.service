[Unit]
Description=fleet-console control plane
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
EnvironmentFile=%h/.config/fleet-console/fleet-console.env
# Optional: TELEGRAM_BOT_TOKEN + TELEGRAM_CHAT_ID for the progress notices
# (mode 0600, never in the repo). Absent -> the app logs one line and sends nothing.
EnvironmentFile=-%h/.config/fleet-console/telegram.env
ExecStart=%h/.local/bin/fleet-console --config %h/.config/fleet-console/config.yaml
Restart=on-failure
RestartSec=2
NoNewPrivileges=true
# No PrivateTmp here: the per-unit mount namespace maps root-owned files to `nobody`, so ssh
# refuses its own system config ("Bad owner or permissions on
# /etc/ssh/ssh_config.d/20-systemd-ssh-proxy.conf") and every git ls-remote the mirror makes
# fails. Loopback-only listen is the isolation that matters for this service.
[Install]
WantedBy=default.target
